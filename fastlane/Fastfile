# fastlane configuration — local release flow for Rotate (Pump/CGM Tracker).
#
# Builds on this Mac and ships to TestFlight and the App Store using an App
# Store Connect API key and Xcode-managed (sigh) signing — no match, no GitHub
# Actions, no registered test devices. Credentials come from the environment;
# keep them in ~/.config/rotate-release.env (never commit it):
#
#   export TEAMID=...                 # Apple Developer Team ID (10 chars)
#   export FASTLANE_ISSUER_ID=...     # App Store Connect API key issuer id
#   export FASTLANE_KEY_ID=...        # API key id
#   export FASTLANE_KEY_PATH=...      # path to the AuthKey_*.p8 file
#   export TESTFLIGHT_GROUP=...       # (optional) external TestFlight group name
#   export BETA_CHANGELOG=...         # (optional) "what to test" for external beta
#
# The Xcode project is generated by XcodeGen from project.yml, so run
# `xcodegen generate` before any build lane.
#
# Lanes:
#   register_app  — register the bundle id (one-time)
#   setup_app     — enable Push + iCloud(CloudKit) capabilities (one-time)
#   beta          — build + upload to TestFlight (internal; external if a group is set)
#   screenshots   — capture App Store screenshots via the UI test (see RELEASE.md)
#   release       — build + upload to the App Store with metadata, then submit for review
#
# One-time website steps an API key CANNOT do: create the App Store Connect app
# record, and create + deploy the CloudKit container/schema (see RELEASE.md and
# the CloudKit issue). Read RELEASE.md before the first `release`.

default_platform(:ios)

platform :ios do
  LOCAL_BUNDLE_ID = "consulting.botanica.rotate"
  LOCAL_PROJECT = File.expand_path("../InsulinPumpSiteJournal.xcodeproj", __dir__)
  LOCAL_SCHEME = "InsulinPumpSiteJournal"
  IPA_PATH = File.expand_path("../Rotate.ipa", __dir__)

  def connect_api_key
    app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["FASTLANE_KEY_PATH"])
    )
  end

  desc "Register the app's bundle id with Apple (one-time)"
  lane :register_app do
    connect_api_key
    if Spaceship::ConnectAPI::BundleId.find(LOCAL_BUNDLE_ID)
      UI.success("Bundle id #{LOCAL_BUNDLE_ID} already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "Rotate", identifier: LOCAL_BUNDLE_ID, platform: "IOS")
      UI.success("Registered bundle id #{LOCAL_BUNDLE_ID}")
    end
  end

  desc "Enable capabilities + report the App Store Connect record status (one-time)"
  lane :setup_app do
    connect_api_key

    bundle_id = Spaceship::ConnectAPI::BundleId.find(LOCAL_BUNDLE_ID)
    UI.user_error!("#{LOCAL_BUNDLE_ID} not registered — run `fastlane register_app` first") unless bundle_id

    existing = bundle_id.get_capabilities.map(&:capability_type)
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    icloud = Spaceship::ConnectAPI::BundleIdCapability::Type::ICLOUD

    if existing.include?(push)
      UI.message("Push Notifications already enabled")
    else
      bundle_id.create_capability(push)
      UI.success("Enabled Push Notifications on #{LOCAL_BUNDLE_ID}")
    end

    # iCloud must declare its CloudKit version or the API rejects it
    # (ICLOUD_VERSION = XCODE_6 is "iCloud including CloudKit"). The CloudKit
    # container itself, and the App Store Connect app record, cannot be created
    # with an API key — Apple only allows GET/UPDATE on those resources — so
    # they're one-time website steps.
    if existing.include?(icloud)
      UI.message("iCloud already enabled")
    else
      bundle_id.create_capability(
        icloud,
        settings: [{ key: "ICLOUD_VERSION", options: [{ key: "XCODE_6" }] }]
      )
      UI.success("Enabled iCloud (CloudKit) on #{LOCAL_BUNDLE_ID}")
    end

    if Spaceship::ConnectAPI::App.find(LOCAL_BUNDLE_ID)
      UI.success("App Store Connect record for #{LOCAL_BUNDLE_ID} exists")
    else
      UI.important("No App Store Connect record yet — create it once at https://appstoreconnect.apple.com (Apps → +). API keys can't create apps.")
    end
  end

  # Sign + build a fresh app-store IPA at ../Rotate.ipa. Shared by beta and
  # release; each run stamps a monotonic, unique build number.
  private_lane :build_appstore_ipa do |options|
    api_key = options[:api_key]

    update_project_team(path: LOCAL_PROJECT, teamid: ENV["TEAMID"])

    increment_build_number(
      xcodeproj: LOCAL_PROJECT,
      build_number: Time.now.utc.strftime("%Y%m%d%H%M")
    )

    # Distribution certificate + App Store provisioning profile. Neither needs
    # a registered device, unlike automatic development signing.
    get_certificates(api_key: api_key)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: LOCAL_BUNDLE_ID,
      team_id: ENV["TEAMID"]
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: LOCAL_PROJECT,
      use_automatic_signing: false,
      team_id: ENV["TEAMID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: [LOCAL_SCHEME]
    )

    gym(
      project: LOCAL_PROJECT,
      scheme: LOCAL_SCHEME,
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["TEAMID"],
        provisioningProfiles: { LOCAL_BUNDLE_ID => profile_name }
      },
      output_directory: File.expand_path("..", __dir__),
      output_name: "Rotate.ipa",
      buildlog_path: File.expand_path("../buildlog", __dir__)
    )
  end

  desc "Build + upload to TestFlight (internal; set TESTFLIGHT_GROUP to also distribute externally)"
  lane :beta do
    api_key = connect_api_key
    build_appstore_ipa(api_key: api_key)

    group = ENV["TESTFLIGHT_GROUP"]
    if group.to_s.empty?
      # Internal testers only — instant, no beta review. Upload and move on.
      upload_to_testflight(
        api_key: api_key,
        ipa: IPA_PATH,
        skip_waiting_for_build_processing: true
      )
      UI.important("Uploaded for INTERNAL testers only. Set TESTFLIGHT_GROUP=\"<group>\" to distribute to external testers (which triggers Beta App Review).")
    else
      # External testers require Beta App Review, and the build must finish
      # processing before it can be distributed — so we wait here.
      upload_to_testflight(
        api_key: api_key,
        ipa: IPA_PATH,
        distribute_external: true,
        groups: [group],
        changelog: ENV["BETA_CHANGELOG"] || "Bug fixes and improvements.",
        notify_external_testers: true,
        skip_waiting_for_build_processing: false
      )
      UI.success("Uploaded and submitted to external group \"#{group}\" for Beta App Review.")
    end
  end

  desc "Capture App Store screenshots (see RELEASE.md — needs the SnapshotHelper wiring)"
  lane :screenshots do
    capture_screenshots
  end

  desc "Build + upload to the App Store with metadata, then submit for review"
  lane :release do
    api_key = connect_api_key
    build_appstore_ipa(api_key: api_key)

    upload_to_app_store(
      api_key: api_key,
      app_identifier: LOCAL_BUNDLE_ID,
      ipa: IPA_PATH,
      skip_binary_upload: false,
      skip_screenshots: false,
      skip_metadata: false,
      submit_for_review: true,
      automatic_release: false,        # you press "Release" after approval
      force: true,                     # don't block on the HTML preview
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false, # standard TLS/Apple crypto only
        add_id_info_uses_idfa: false               # no ads / no IDFA
      }
    )
  end
end
