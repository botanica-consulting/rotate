# fastlane configuration — local release flow for Rotate (Pump/CGM Tracker).
#
# Builds on this Mac and uploads to TestFlight using an App Store Connect API
# key and Xcode-managed (sigh) signing — no match, no GitHub Actions, and no
# registered test devices needed. Credentials come from the environment; keep
# them in ~/.config/rotate-release.env (never commit it):
#
#   export TEAMID=...                 # Apple Developer Team ID (10 chars)
#   export FASTLANE_ISSUER_ID=...     # App Store Connect API key issuer id
#   export FASTLANE_KEY_ID=...        # API key id
#   export FASTLANE_KEY_PATH=...      # path to the AuthKey_*.p8 file
#
# The Xcode project is generated by XcodeGen from project.yml, so run
# `xcodegen generate` before `fastlane beta`.
#
# One-time setup for a fresh Apple account/team:
#   1. fastlane register_app   — register the bundle id
#   2. fastlane setup_app      — enable Push + iCloud(CloudKit) capabilities
#   3. On the Apple websites (an API key can't do these): create the App Store
#      Connect app record, and create + assign the CloudKit container.
# Then `fastlane beta` for every build.

default_platform(:ios)

platform :ios do
  LOCAL_BUNDLE_ID = "consulting.botanica.rotate"
  LOCAL_PROJECT = File.expand_path("../InsulinPumpSiteJournal.xcodeproj", __dir__)

  desc "Register the app's bundle id with Apple (one-time)"
  lane :register_app do
    app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["FASTLANE_KEY_PATH"])
    )
    if Spaceship::ConnectAPI::BundleId.find(LOCAL_BUNDLE_ID)
      UI.success("Bundle id #{LOCAL_BUNDLE_ID} already registered")
    else
      Spaceship::ConnectAPI::BundleId.create(name: "Rotate", identifier: LOCAL_BUNDLE_ID, platform: "IOS")
      UI.success("Registered bundle id #{LOCAL_BUNDLE_ID}")
    end
  end

  desc "Enable capabilities + report the App Store Connect record status (one-time)"
  lane :setup_app do
    app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["FASTLANE_KEY_PATH"])
    )

    bundle_id = Spaceship::ConnectAPI::BundleId.find(LOCAL_BUNDLE_ID)
    UI.user_error!("#{LOCAL_BUNDLE_ID} not registered — run `fastlane register_app` first") unless bundle_id

    existing = bundle_id.get_capabilities.map(&:capability_type)
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    icloud = Spaceship::ConnectAPI::BundleIdCapability::Type::ICLOUD

    if existing.include?(push)
      UI.message("Push Notifications already enabled")
    else
      bundle_id.create_capability(push)
      UI.success("Enabled Push Notifications on #{LOCAL_BUNDLE_ID}")
    end

    # iCloud must declare its CloudKit version or the API rejects it
    # (ICLOUD_VERSION = XCODE_6 is "iCloud including CloudKit"). The CloudKit
    # container itself, and the App Store Connect app record, cannot be created
    # with an API key — Apple only allows GET/UPDATE on those resources — so
    # they're one-time website steps.
    if existing.include?(icloud)
      UI.message("iCloud already enabled")
    else
      bundle_id.create_capability(
        icloud,
        settings: [{ key: "ICLOUD_VERSION", options: [{ key: "XCODE_6" }] }]
      )
      UI.success("Enabled iCloud (CloudKit) on #{LOCAL_BUNDLE_ID}")
    end

    if Spaceship::ConnectAPI::App.find(LOCAL_BUNDLE_ID)
      UI.success("App Store Connect record for #{LOCAL_BUNDLE_ID} exists")
    else
      UI.important("No App Store Connect record yet — create it once at https://appstoreconnect.apple.com (Apps → +). API keys can't create apps.")
    end
  end

  desc "Build + upload to TestFlight (cert + sigh, no devices needed)"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["FASTLANE_KEY_PATH"])
    )

    update_project_team(path: LOCAL_PROJECT, teamid: ENV["TEAMID"])

    # Monotonic build number without needing to query TestFlight.
    increment_build_number(
      xcodeproj: LOCAL_PROJECT,
      build_number: Time.now.utc.strftime("%Y%m%d%H%M")
    )

    # Distribution certificate + App Store provisioning profile. Neither needs
    # a registered device, unlike automatic development signing.
    get_certificates(api_key: api_key)
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: LOCAL_BUNDLE_ID,
      team_id: ENV["TEAMID"]
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    update_code_signing_settings(
      path: LOCAL_PROJECT,
      use_automatic_signing: false,
      team_id: ENV["TEAMID"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["InsulinPumpSiteJournal"]
    )

    gym(
      project: LOCAL_PROJECT,
      scheme: "InsulinPumpSiteJournal",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: ENV["TEAMID"],
        provisioningProfiles: { LOCAL_BUNDLE_ID => profile_name }
      },
      output_directory: File.expand_path("..", __dir__),
      output_name: "Rotate.ipa",
      buildlog_path: File.expand_path("../buildlog", __dir__)
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.expand_path("../Rotate.ipa", __dir__),
      skip_waiting_for_build_processing: true
    )
  end

  desc "Regenerate the App Store screenshots (6.9\", clean 9:41 status bar)"
  lane :screenshots do
    # Reads fastlane/Snapfile: the Screenshots scheme, iPhone 17 Pro Max,
    # seeded demo data. Output -> fastlane/screenshots.
    capture_screenshots
  end

  # deliver reads listing text from fastlane/metadata and images from
  # fastlane/screenshots. skip_binary_upload keeps this metadata-only — the
  # binary is uploaded separately by `beta`. First-time-only fields that no
  # API key can set (age rating, App Privacy "Data Not Collected", the review
  # contact) are documented in docs/APP_STORE.md.
  desc "Upload App Store listing text + screenshots (no binary, no submit)"
  lane :metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["FASTLANE_KEY_PATH"])
    )

    upload_to_app_store(
      api_key: api_key,
      app_identifier: LOCAL_BUNDLE_ID,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true,                 # skip the HTML preview confirmation
      run_precheck_before_submit: false,
      submit_for_review: false
    )
  end

  desc "Upload metadata + screenshots and submit the latest build for review"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["FASTLANE_KEY_ID"],
      issuer_id: ENV["FASTLANE_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["FASTLANE_KEY_PATH"])
    )

    # Uses the most recent processed build (uploaded by `beta`). Encryption is
    # already declared non-exempt (ITSAppUsesNonExemptEncryption=false), so no
    # export-compliance prompt.
    upload_to_app_store(
      api_key: api_key,
      app_identifier: LOCAL_BUNDLE_ID,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      force: true,
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
