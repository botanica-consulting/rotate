# fastlane snapshot — App Store marketing screenshots for Rotate.
#
# Generates a 6.9" iPhone set (the only size App Store Connect requires for an
# iPhone-only app; smaller sizes are scaled from it). Run with `fastlane
# screenshots`; output lands in ./fastlane/screenshots and is picked up by the
# `metadata`/`release` lanes.

project("./InsulinPumpSiteJournal.xcodeproj")
scheme("Screenshots")

# iPhone 17 Pro Max is a 6.9" device — the required App Store display size.
devices(["iPhone 17 Pro Max"])
languages(["en-US"])

output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

# One simulator at a time keeps the seeded state deterministic.
concurrent_simulators(false)
stop_after_first_error(true)

# Clean marketing chrome: 9:41, full battery, full signal.
override_status_bar(true)
